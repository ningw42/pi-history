{
  "name": "pi-history",
  "version": "0.1.0",
  "description": "One history modal for Pi: Ctrl+R opens a Pi-drawn overlay of the prompts you typed before.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^24",
    "typescript": "^5.9"
  }
}
