{
  "name": "pi-history",
  "version": "0.0.1",
  "private": true,
  "description": "One history modal for Pi: Ctrl+R opens a Pi-drawn overlay of the prompts you typed before.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "config": {
    "minimumMatcherVersions": {
      "fzf": "0.67.0",
      "skim": "4.7.0"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "release:check": "node scripts/check-node.mjs && node scripts/check-release.mjs",
    "typecheck": "node scripts/check-node.mjs && tsc --noEmit",
    "test": "npm run test:functional && npm run test:performance",
    "test:functional": "node scripts/check-node.mjs && node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:performance": "node scripts/check-node.mjs && node --test --test-concurrency=1 --test-reporter=spec \"test/performance/**/*.perf.ts\"",
    "test:pty": "node scripts/check-node.mjs && node --test --test-reporter=spec test/pty/smoke.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.2",
    "@earendil-works/pi-tui": ">=1.5.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9"
  }
}
