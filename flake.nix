{
  description = "Optional development shell and Git hooks for pi-history";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";
    git-hooks = {
      url = "github:cachix/git-hooks.nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs =
    { nixpkgs, git-hooks, ... }:
    let
      systems = [
        "x86_64-linux"
        "aarch64-linux"
        "aarch64-darwin"
      ];
      forAllSystems = nixpkgs.lib.genAttrs systems;
      perSystem = forAllSystems (
        system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
          npmCheck = pkgs.writeShellApplication {
            name = "pi-history-check";
            runtimeInputs = [
              pkgs.nodejs_26
              pkgs.git
              pkgs.fzf
            ];
            text = "npm run check";
          };
          mkHooks =
            includeNpm:
            git-hooks.lib.${system}.run {
              src = ./.;
              install.enable = false;
              hooks = {
                nixfmt.enable = true;
                actionlint.enable = true;
                npm-check = {
                  enable = includeNpm;
                  name = "Typecheck and tests";
                  entry = "${npmCheck}/bin/pi-history-check";
                  files = "^(src/|test/|scripts/|package(-lock)?\\.json$|tsconfig\\.json$|\\.node-version$)";
                  pass_filenames = false;
                };
              };
            };
          devHooks = mkHooks true;
        in
        {
          # npm needs the contributor's node_modules; keep it out of sandboxed checks.
          checks.pre-commit = mkHooks false;
          devShell = pkgs.mkShellNoCC {
            packages = [
              pkgs.nodejs_26
              pkgs.git
              pkgs.fzf
            ]
            ++ devHooks.enabledPackages;
            shellHook = devHooks.shellHook + ''
              # Only maintain our generated config link, never replace contributor config.
              if root=$(git rev-parse --show-toplevel 2>/dev/null); then
                config_path="$root/.pre-commit-config.yaml"
                if [ ! -e "$config_path" ] && [ ! -L "$config_path" ]; then
                  ln -s ${devHooks.config.configFile} "$config_path"
                elif [ -L "$config_path" ] && grep -q '^# This file was generated by git-hooks.nix$' "$config_path"; then
                  ln -sfn ${devHooks.config.configFile} "$config_path"
                else
                  echo "Keeping existing .pre-commit-config.yaml; Nix hooks are not configured." >&2
                fi
                unset config_path root
              fi
            '';
          };
          formatter = pkgs.nixfmt;
        }
      );
    in
    {
      checks = forAllSystems (system: perSystem.${system}.checks);
      devShells = forAllSystems (system: {
        default = perSystem.${system}.devShell;
      });
      formatter = forAllSystems (system: perSystem.${system}.formatter);
    };
}
